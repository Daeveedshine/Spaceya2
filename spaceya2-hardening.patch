@@ -0,0 +1,20 @@
+import { App, cert, getApps, initializeApp } from 'firebase-admin/app';
+import { Firestore, getFirestore } from 'firebase-admin/firestore';
+
+/**
+ * Server credentials. Set FIREBASE_SERVICE_ACCOUNT to the service-account JSON
+ * (as a single-line string) in Vercel / your server env. Never prefix it with VITE_.
+ */
+export const getAdminApp = (): App => {
+  const existing = getApps()[0];
+  if (existing) return existing;
+  const raw = process.env.FIREBASE_SERVICE_ACCOUNT;
+  if (!raw) throw new Error('FIREBASE_SERVICE_ACCOUNT is not set');
+  return initializeApp({ credential: cert(JSON.parse(raw)) });
+};
+
+export const getDb = (): Firestore => {
+  const databaseId = process.env.VITE_FIRESTORE_DATABASE_ID || process.env.FIRESTORE_DATABASE_ID;
+  const app = getAdminApp();
+  return databaseId && databaseId !== '(default)' ? getFirestore(app, databaseId) : getFirestore(app);
+};
diff --git a/api/_lib/http.ts b/api/_lib/http.ts
new file mode 100644
index 0000000..ee88ad9
--- /dev/null
+++ b/api/_lib/http.ts
@@ -0,0 +1,60 @@
+import type { IncomingMessage } from 'http';
+import { getAuth } from 'firebase-admin/auth';
+import { getAdminApp } from './firebase';
+
+/** Minimal request/response shapes shared by Vercel functions and Express. */
+export interface Req extends IncomingMessage {
+  body?: any;
+  method?: string;
+}
+export interface Res {
+  status(code: number): Res;
+  json(body: unknown): void;
+  setHeader(name: string, value: string): void;
+}
+
+export class HttpError extends Error {
+  constructor(public status: number, message: string) {
+    super(message);
+  }
+}
+
+/** Reads the unparsed request body (needed for webhook signature checks). */
+export const readRawBody = async (req: Req): Promise<Buffer> => {
+  if (Buffer.isBuffer(req.body)) return req.body; // express.raw()
+  const chunks: Buffer[] = [];
+  for await (const chunk of req) chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
+  return Buffer.concat(chunks);
+};
+
+/** Verifies the Firebase ID token in `Authorization: Bearer <token>`. */
+export const requireUser = async (req: Req): Promise<{ uid: string }> => {
+  const header = String(req.headers['authorization'] || '');
+  const match = header.match(/^Bearer (.+)$/);
+  if (!match) throw new HttpError(401, 'Missing auth token');
+  try {
+    const decoded = await getAuth(getAdminApp()).verifyIdToken(match[1]);
+    return { uid: decoded.uid };
+  } catch {
+    throw new HttpError(401, 'Invalid auth token');
+  }
+};
+
+/** Wraps a handler: POST only, JSON errors, no stack traces or internals leaked. */
+export const route =
+  (handler: (req: Req) => Promise<unknown>) =>
+  async (req: Req, res: Res) => {
+    res.setHeader('Cache-Control', 'no-store');
+    if (req.method !== 'POST') {
+      res.setHeader('Allow', 'POST');
+      return res.status(405).json({ error: 'Method not allowed' });
+    }
+    try {
+      const result = await handler(req);
+      return res.status(200).json(result ?? { ok: true });
+    } catch (err) {
+      if (err instanceof HttpError) return res.status(err.status).json({ error: err.message });
+      console.error('Unhandled API error:', err);
+      return res.status(500).json({ error: 'Internal error' });
+    }
+  };
diff --git a/api/_lib/paystack.ts b/api/_lib/paystack.ts
new file mode 100644
index 0000000..1a672db
--- /dev/null
+++ b/api/_lib/paystack.ts
@@ -0,0 +1,40 @@
+import crypto from 'crypto';
+import { HttpError } from './http';
+
+export interface PaystackVerifyData {
+  status: string;
+  reference: string;
+  amount: number; // kobo
+  currency: string;
+  metadata?: { uid?: string } | null;
+}
+
+/** Asks Paystack (server-to-server, with the secret key) what really happened to a reference. */
+export const verifyReference = async (reference: string): Promise<PaystackVerifyData> => {
+  const secret = process.env.PAYSTACK_SECRET_KEY;
+  if (!secret) throw new Error('PAYSTACK_SECRET_KEY is not set');
+  const res = await fetch(`https://api.paystack.co/transaction/verify/${encodeURIComponent(reference)}`, {
+    headers: { Authorization: `Bearer ${secret}` },
+  });
+  if (res.status === 404) throw new HttpError(404, 'Payment not found');
+  const body: any = await res.json().catch(() => null);
+  if (!res.ok || !body?.status || !body.data) throw new HttpError(502, 'Could not verify payment');
+  return body.data as PaystackVerifyData;
+};
+
+export const isValidSignature = (rawBody: Buffer, signature: string | undefined): boolean => {
+  const secret = process.env.PAYSTACK_SECRET_KEY;
+  if (!secret || !signature) return false;
+  const expected = crypto.createHmac('sha512', secret).update(rawBody).digest('hex');
+  const a = Buffer.from(expected);
+  const b = Buffer.from(signature);
+  return a.length === b.length && crypto.timingSafeEqual(a, b);
+};
+
+/** Shared by the verify endpoint and the webhook: only a confirmed NGN payment for this uid counts. */
+export const assertConfirmedPayment = (data: PaystackVerifyData, uid: string) => {
+  if (data.status !== 'success') throw new HttpError(402, 'Payment not successful');
+  if (data.currency !== 'NGN') throw new HttpError(400, 'Unsupported currency');
+  if (data.metadata?.uid !== uid) throw new HttpError(403, 'Payment does not belong to this account');
+  return data.amount / 100;
+};
diff --git a/api/_lib/wallet.ts b/api/_lib/wallet.ts
new file mode 100644
index 0000000..519e6d3
--- /dev/null
+++ b/api/_lib/wallet.ts
@@ -0,0 +1,110 @@
+import { FieldValue, Timestamp } from 'firebase-admin/firestore';
+import { getDb } from './firebase';
+import { HttpError } from './http';
+
+export const COMPANY_WALLET_ID = 'COMPANY_WALLET_0';
+export const ASSIGNMENT_FEE = 1000; // NGN, same value the client used to hardcode
+export const MIN_DEPOSIT = 100; // NGN
+export const MAX_DEPOSIT = 5_000_000; // NGN
+
+const ref = (prefix: string) => `${prefix}-${Date.now()}-${Math.floor(Math.random() * 900000) + 100000}`;
+
+/**
+ * Credits a wallet for a confirmed Paystack payment.
+ * Idempotent: the transaction document id is derived from the Paystack reference,
+ * so a replayed verify call or a webhook retry cannot credit twice.
+ */
+export const creditDeposit = async (uid: string, amountNaira: number, reference: string, description: string) => {
+  const db = getDb();
+  const txRef = db.collection('transactions').doc(`deposit_${reference}`);
+  const walletRef = db.collection('wallets').doc(uid);
+  const userRef = db.collection('users').doc(uid);
+
+  return db.runTransaction(async (t) => {
+    const [txSnap, walletSnap, userSnap] = await Promise.all([t.get(txRef), t.get(walletRef), t.get(userRef)]);
+    if (!userSnap.exists) throw new HttpError(404, 'User not found');
+    if (txSnap.exists) {
+      return { credited: false, balance: walletSnap.exists ? (walletSnap.data()!.balance as number) : 0, reference };
+    }
+    const balance = (walletSnap.exists ? (walletSnap.data()!.balance as number) || 0 : 0) + amountNaira;
+    if (walletSnap.exists) t.update(walletRef, { balance });
+    else t.set(walletRef, { user_id: uid, balance, status: 'active', created_at: Timestamp.now() });
+    t.update(userRef, { walletBalance: balance });
+    t.set(txRef, {
+      user_id: uid,
+      type: 'deposit',
+      amount: amountNaira,
+      status: 'success',
+      reference,
+      description,
+      created_at: Timestamp.now(),
+    });
+    return { credited: true, balance, reference };
+  });
+};
+
+/** Charges the agent the tenant-assignment fee and credits the company wallet. */
+export const chargeAssignmentFee = async (agentId: string, tenantId: string, propertyId: string) => {
+  const db = getDb();
+  const propRef = db.collection('properties').doc(propertyId);
+  const tenantRef = db.collection('users').doc(tenantId);
+  const agentWalletRef = db.collection('wallets').doc(agentId);
+  const agentUserRef = db.collection('users').doc(agentId);
+  const companyRef = db.collection('wallets').doc(COMPANY_WALLET_ID);
+
+  return db.runTransaction(async (t) => {
+    const [prop, tenant, wallet, company] = await Promise.all([
+      t.get(propRef), t.get(tenantRef), t.get(agentWalletRef), t.get(companyRef),
+    ]);
+    if (!prop.exists || prop.data()!.agentId !== agentId) throw new HttpError(403, 'Property not found');
+    if (prop.data()!.tenantId) throw new HttpError(409, 'Property already has a tenant');
+    if (!tenant.exists || tenant.data()!.role !== 'TENANT') throw new HttpError(404, 'Tenant not found');
+
+    const balance = wallet.exists ? (wallet.data()!.balance as number) || 0 : 0;
+    if (balance < ASSIGNMENT_FEE) throw new HttpError(402, 'Insufficient wallet balance');
+
+    const newBalance = balance - ASSIGNMENT_FEE;
+    t.update(agentWalletRef, { balance: newBalance });
+    t.update(agentUserRef, { walletBalance: newBalance });
+    if (company.exists) t.update(companyRef, { balance: FieldValue.increment(ASSIGNMENT_FEE) });
+    else t.set(companyRef, { user_id: 0, balance: ASSIGNMENT_FEE, status: 'active', created_at: Timestamp.now() });
+
+    const reference = ref('ASSIGN');
+    t.set(db.collection('transactions').doc(), {
+      user_id: agentId, type: 'deduction', amount: ASSIGNMENT_FEE, status: 'success',
+      reference: `${reference}-A`, description: `Tenant assignment fee: Property ${propertyId}`, created_at: Timestamp.now(),
+    });
+    t.set(db.collection('transactions').doc(), {
+      user_id: 0, type: 'credit', amount: ASSIGNMENT_FEE, status: 'success',
+      reference: `${reference}-C`, description: `Earnings from tenant assignment: Property ${propertyId}`, created_at: Timestamp.now(),
+    });
+    return { balance: newBalance, reference: `${reference}-A` };
+  });
+};
+
+/**
+ * Records a withdrawal request and holds the funds. This does NOT move money:
+ * payouts are 'pending' until someone pays them out (or Paystack Transfers is wired in).
+ */
+export const requestWithdrawal = async (uid: string, amountNaira: number) => {
+  const db = getDb();
+  const walletRef = db.collection('wallets').doc(uid);
+  const userRef = db.collection('users').doc(uid);
+  return db.runTransaction(async (t) => {
+    const wallet = await t.get(walletRef);
+    const balance = wallet.exists ? (wallet.data()!.balance as number) || 0 : 0;
+    if (balance < amountNaira) throw new HttpError(402, 'Insufficient balance');
+    const newBalance = balance - amountNaira;
+    const reference = ref('WDR');
+    t.update(walletRef, { balance: newBalance });
+    t.update(userRef, { walletBalance: newBalance });
+    t.set(db.collection('transactions').doc(), {
+      user_id: uid, type: 'withdrawal', amount: amountNaira, status: 'pending',
+      reference, description: 'Withdrawal request (pending manual payout)', created_at: Timestamp.now(),
+    });
+    return { balance: newBalance, reference };
+  });
+};
+
+export const isValidAmount = (n: unknown, min = 1, max = MAX_DEPOSIT): n is number =>
+  typeof n === 'number' && Number.isFinite(n) && Number.isInteger(n) && n >= min && n <= max;
diff --git a/api/paystack-webhook.ts b/api/paystack-webhook.ts
new file mode 100644
index 0000000..4b3c4bc
--- /dev/null
+++ b/api/paystack-webhook.ts
@@ -0,0 +1,30 @@
+import { readRawBody, Req, Res } from './_lib/http';
+import { isValidSignature, verifyReference } from './_lib/paystack';
+import { creditDeposit } from './_lib/wallet';
+
+// Vercel: we need the raw bytes to check Paystack's HMAC signature.
+export const config = { api: { bodyParser: false } };
+
+/** Paystack calls this when a charge succeeds, even if the user closed the tab before the client could verify. */
+export default async function handler(req: Req, res: Res) {
+  if (req.method !== 'POST') return res.status(405).json({ error: 'Method not allowed' });
+  try {
+    const raw = await readRawBody(req);
+    if (!isValidSignature(raw, req.headers['x-paystack-signature'] as string | undefined)) {
+      return res.status(401).json({ error: 'Bad signature' });
+    }
+    const event = JSON.parse(raw.toString('utf8'));
+    if (event?.event !== 'charge.success') return res.status(200).json({ ok: true });
+
+    // Don't trust the event payload for money: re-ask Paystack.
+    const data = await verifyReference(String(event.data?.reference || ''));
+    const uid = data.metadata?.uid;
+    if (data.status === 'success' && data.currency === 'NGN' && typeof uid === 'string') {
+      await creditDeposit(uid, data.amount / 100, data.reference, 'Wallet funding via Paystack');
+    }
+    return res.status(200).json({ ok: true });
+  } catch (err) {
+    console.error('Paystack webhook failed:', err);
+    return res.status(500).json({ error: 'Webhook error' }); // non-2xx makes Paystack retry
+  }
+}
diff --git a/api/wallet/assignment-fee.ts b/api/wallet/assignment-fee.ts
new file mode 100644
