+import { HttpError, requireUser, route } from '../_lib/http';
+import { creditDeposit, isValidAmount } from '../_lib/wallet';
+
+/**
+ * Local/testing top-up so you can try the app without Paystack.
+ * Disabled unless ALLOW_SIMULATED_FUNDING=true AND NODE_ENV is not production.
+ */
+export default route(async (req) => {
+  if (process.env.ALLOW_SIMULATED_FUNDING !== 'true' || process.env.NODE_ENV === 'production') {
+    throw new HttpError(404, 'Not found');
+  }
+  const { uid } = await requireUser(req);
+  const amount = req.body?.amount;
+  if (!isValidAmount(amount, 1, 100_000)) throw new HttpError(400, 'Invalid amount');
+  return creditDeposit(uid, amount, `DEV-${Date.now()}-${Math.floor(Math.random() * 1e6)}`, 'Simulated wallet funding (dev)');
+});
diff --git a/api/wallet/verify.ts b/api/wallet/verify.ts
new file mode 100644
index 0000000..c0adb85
--- /dev/null
+++ b/api/wallet/verify.ts
@@ -0,0 +1,14 @@
+import { HttpError, requireUser, route } from '../_lib/http';
+import { assertConfirmedPayment, verifyReference } from '../_lib/paystack';
+import { creditDeposit } from '../_lib/wallet';
+
+export default route(async (req) => {
+  const { uid } = await requireUser(req);
+  const reference = req.body?.reference;
+  if (typeof reference !== 'string' || !/^[A-Za-z0-9_\-]{6,100}$/.test(reference)) {
+    throw new HttpError(400, 'Invalid reference');
+  }
+  const data = await verifyReference(reference);
+  const amount = assertConfirmedPayment(data, uid);
+  return creditDeposit(uid, amount, reference, 'Wallet funding via Paystack');
+});
