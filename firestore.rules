rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PHASE 3: Primitives ---
    function isSignedIn() { 
      return request.auth != null; 
    }

    function isVerified() {
      return isSignedIn(); // Relaxed for dev preview: && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isRole(roleStr) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleStr;
    }

    function isAdmin() {
      return isVerified() && isRole('ADMIN');
    }

    function isOwner(obj) {
      return isSignedIn() && (
        obj.user_id == request.auth.uid || 
        obj.userId == request.auth.uid ||
        obj.id == request.auth.uid ||
        (request.auth.uid == obj.user_id) // Extra safety check
      );
    }

    // --- Bootstrapped connection check ---
    match /test/connection {
      allow read: if true; // Publicly readable for boot check
    }

    // --- PHASE 4: Fortress Rules ---

    // 1. USERS
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['id', 'name', 'email', 'role'])
          && data.size() >= 4 && data.size() <= 15
          && data.id is string && data.id.size() > 0 && data.id.size() <= 128
          && data.name is string && data.name.size() > 0 && data.name.size() <= 150
          && data.email is string && data.email.size() > 0 && data.email.size() <= 150
          && data.role is string && data.role in ['ADMIN', 'AGENT', 'TENANT']
          && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
          && (!('walletBalance' in data) || (data.walletBalance is number))
          && (!('profilePictureUrl' in data) || (data.profilePictureUrl is string && data.profilePictureUrl.size() <= 2048))
          && (!('assignedPropertyIds' in data) || (data.assignedPropertyIds is list && data.assignedPropertyIds.size() <= 100))
          && (!('suiteId' in data) || (data.suiteId is string && data.suiteId.size() <= 128));
      }

      // Self-registration can only create AGENT or TENANT accounts, with an empty wallet.
      // ADMIN accounts must be created/promoted with the Admin SDK or the console.
      allow create: if isSignedIn()
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().id == userId
                    && userId == request.auth.uid
                    && incoming().role in ['AGENT', 'TENANT']
                    && incoming().get('walletBalance', 0) == 0;

      // Admins and agents can see user profiles; everyone else only sees themselves and agents.
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        isRole('AGENT') ||
        resource.data.id == request.auth.uid ||
        resource.data.role == 'AGENT'
      );

      allow update: if isVerified() 
                    && isValidUser(incoming())
                    && incoming().id == existing().id // Entity remains same
                    && incoming().role == existing().role // Role is immutable
                    && incoming().email == existing().email // Email is immutable
                    && incoming().get('walletBalance', null) == existing().get('walletBalance', null) // Balance is server-written only
                    && (
                      isAdmin() ||
                      // Action: User update profile
                      (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'profilePictureUrl', 'assignedPropertyIds'])) ||
                      // Action: Agent or internal system update balance/assignments for TENANTS
                      (isRole('AGENT') && incoming().diff(existing()).affectedKeys().hasOnly(['assignedPropertyIds']) && existing().role == 'TENANT')
                    );
    }

    // 2. PROPERTIES
    match /properties/{propertyId} {
      function isValidProperty(data) {
        return data.keys().hasAll(['id', 'name', 'location', 'rent', 'status', 'agentId', 'category', 'type'])
          && data.size() >= 8 && data.size() <= 20
          && data.id is string && data.id.size() <= 128
          && data.name is string && data.name.size() <= 200
          && data.location is string && data.location.size() <= 300
          && data.rent is number && data.rent >= 0
          && data.status is string && data.status in ['DRAFT', 'LISTED', 'OCCUPIED', 'VACANT', 'ARCHIVED']
          && data.agentId is string && data.agentId.size() <= 128
          && data.category is string && data.category.size() <= 100
          && data.type is string && data.type.size() <= 100
          && (!('images' in data) || (data.images is list && data.images.size() <= 20))
          && (!('rentPaid' in data) || (data.rentPaid is number && data.rentPaid >= 0))
          && (!('rentReminderPeriod' in data) || (data.rentReminderPeriod is string && data.rentReminderPeriod in ['1_MONTH', '2_WEEKS']))
          && (!('rentReminders' in data) || (data.rentReminders is list && data.rentReminders.size() <= 10));
      }

      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.agentId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.status in ['LISTED', 'VACANT']
      );
      
      allow create: if isVerified() 
                    && (isRole('AGENT') || isAdmin())
                    && isValidId(propertyId)
                    && isValidProperty(incoming())
                    && incoming().id == propertyId
                    && incoming().agentId == request.auth.uid;

      allow update: if isVerified()
                    && isValidProperty(incoming())
                    && (
                      isAdmin() ||
                      (existing().agentId == request.auth.uid && incoming().agentId == existing().agentId && incoming().id == existing().id && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'location', 'rent', 'status', 'description', 'category', 'type', 'images', 'tenantId', 'rentStartDate', 'rentExpiryDate', 'rentPaid', 'rentReminderPeriod']))
                    );

      allow delete: if isSignedIn() && (existing().agentId == request.auth.uid || isAdmin());
    }

    // 3. APPLICATIONS
    match /applications/{applicationId} {
      function isValidApplication(data) {
        return data.keys().hasAll(['id', 'userId', 'propertyId', 'agentId', 'status', 'submissionDate'])
          && data.size() >= 6 && data.size() <= 150
          && data.id is string && data.id.size() <= 200
          && data.userId is string && data.userId.size() <= 200
          && data.propertyId is string && data.propertyId.size() <= 200
          && data.agentId is string && data.agentId.size() <= 200
          && data.status is string && data.status in ['PENDING', 'REVIEWING', 'APPROVED', 'REJECTED', 'MORE_INFO_REQUIRED']
          && data.submissionDate is string;
      }

      allow create: if isVerified()
                    && isValidId(applicationId)
                    && isValidApplication(incoming())
                    && incoming().id == applicationId
                    && incoming().userId == request.auth.uid
                    && incoming().status == 'PENDING';

      // Applications hold IDs, DOB and landlord details: only the applicant, their agent, or an admin.
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.agentId == request.auth.uid
      );

      allow update: if isVerified()
                    && isValidApplication(incoming())
                    && incoming().id == existing().id
                    && incoming().userId == existing().userId
                    && (
                      incoming().diff(existing()).affectedKeys().size() == 0 ||
                      isAdmin() ||
                      // Action: Agent review and route property
                      (request.auth.uid == existing().agentId && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'propertyId', 'riskScore', 'aiRecommendation', 'customResponses'])) ||
                      // Action: Tenant edit
                      (request.auth.uid == existing().userId && (existing().status == 'PENDING' || existing().status == 'MORE_INFO_REQUIRED') && !incoming().diff(existing()).affectedKeys().hasAny(['status', 'agentId', 'propertyId', 'riskScore', 'aiRecommendation']))
                    );
    }

    // 4. AGREEMENTS
    match /agreements/{agreementId} {
      function isValidAgreement(data) {
        return data.keys().hasAll(['id', 'propertyId', 'tenantId', 'agentId', 'startDate', 'endDate', 'status', 'version'])
          && data.size() >= 8 && data.size() <= 15
          && data.id is string && data.id.size() <= 128
          && data.propertyId is string && data.propertyId.size() <= 128
          && data.tenantId is string && data.tenantId.size() <= 128
          && data.agentId is string && data.agentId.size() <= 128
          && data.status in ['active', 'expired', 'terminated'];
      }

      // Secure Read: only participants (or an admin) can see the agreement
      allow read, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.agentId == request.auth.uid
      );
      
      allow create: if isVerified() 
                    && isValidAgreement(incoming())
                    && (isAdmin() || incoming().agentId == request.auth.uid);

      allow update: if isVerified()
                    && isValidAgreement(incoming())
                    && incoming().id == existing().id
                    && incoming().propertyId == existing().propertyId
                    && incoming().tenantId == existing().tenantId
                    && incoming().agentId == existing().agentId
                    && (
                      isAdmin() ||
                      existing().agentId == request.auth.uid
                    );
    }

    // 5. MAINTENANCE TICKETS
    match /tickets/{ticketId} {
      allow read, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.agentId == request.auth.uid
      );
      
      allow create: if isVerified() 
                    && incoming().id == ticketId
                    && incoming().tenantId == request.auth.uid;

      allow update: if isVerified()
                    && incoming().id == existing().id
                    && incoming().propertyId == existing().propertyId
                    && (
                      isAdmin() ||
                      request.auth.uid == existing().tenantId ||
                      request.auth.uid == existing().agentId
                    );
    }

    // 6. PAYMENTS, WALLETS & TRANSACTIONS
    // Money is written ONLY by the server (Admin SDK bypasses these rules): see api/wallet/* and
    // api/paystack-webhook.ts. Clients may read their own records and never write.
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.tenantId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /wallets/{walletId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.user_id == request.auth.uid);
      allow write: if false;
    }

    match /bank_accounts/{accountId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.user_id == request.auth.uid);
      allow write: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.user_id == request.auth.uid ||
        resource.data.get('userId', null) == request.auth.uid
      );
      allow write: if false;
    }

    // 7. NOTIFICATIONS
    match /notifications/{notificationId} {
      function isValidNotification(data) {
        return data.keys().hasAll(['id', 'userId', 'title', 'message', 'type', 'timestamp', 'isRead'])
          && data.size() >= 7 && data.size() <= 15
          && data.id is string
          && data.userId is string;
      }
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidNotification(incoming()) && (
        incoming().userId == request.auth.uid || 
        isRole('AGENT') || 
        isAdmin() ||
        (incoming().linkTo == 'maintenance' && exists(/databases/$(database)/documents/users/$(incoming().userId)) && get(/databases/$(database)/documents/users/$(incoming().userId)).data.role == 'AGENT')
      ); 
    }

    // 9. CONSENT RECORDS (terms/privacy acceptance). Owner writes their own; admins read.
    match /consents/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isVerified()
                    && request.auth.uid == userId
                    && incoming().userId == userId
                    && incoming().keys().hasOnly(['userId', 'termsVersion', 'privacyVersion', 'acceptedAt', 'userAgent'])
                    && incoming().termsVersion is string && incoming().termsVersion.size() <= 32
                    && incoming().privacyVersion is string && incoming().privacyVersion.size() <= 32
                    && incoming().acceptedAt is string && incoming().acceptedAt.size() <= 40
                    && incoming().userAgent is string && incoming().userAgent.size() <= 300;
      allow delete: if false;
    }

    // 10. DATA SUBJECT REQUESTS (export / correction / deletion). Owner creates; admins manage.
    match /dataRequests/{requestId} {
      allow create: if isVerified()
                    && incoming().userId == request.auth.uid
                    && incoming().keys().hasOnly(['userId', 'email', 'name', 'type', 'note', 'status', 'createdAt'])
                    && incoming().type in ['DELETE_ACCOUNT', 'EXPORT_DATA', 'CORRECTION']
                    && incoming().status == 'OPEN'
                    && incoming().note is string && incoming().note.size() <= 1000
                    && incoming().email is string && incoming().email.size() <= 150
                    && incoming().name is string && incoming().name.size() <= 150
                    && incoming().createdAt is string && incoming().createdAt.size() <= 40;
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // 8. FORM TEMPLATES
    match /formTemplates/{templateId} {
      allow read, list: if isSignedIn();
      allow create, update: if isVerified() && (request.auth.uid == templateId || isAdmin());
    }

  }
}
